# BorrowHub Environment Configuration

# Application
PROJECT_NAME="BorrowHub"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Database Connection (MySQL 8.0+)
DATABASE_URL="mysql+pymysql://<user>:<password>@<host>:3306/<database>?charset=utf8mb4"

# Security & Authentication
JWT_SECRET_KEY="replace-with-a-random-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OTP_EXPIRY_MINUTES=15

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cloudinary Image Upload
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5500","http://127.0.0.1:5500","http://localhost:8000","http://127.0.0.1:8000","null","*"]

# SMTP Real Email Dispatch (Configure Gmail or SMTP to send real OTPs to student inboxes)
# For Gmail: Use smtp.gmail.com, port 587, your email, and a 16-character Google App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="your-verified-sender@example.com"
SMTP_FROM_NAME="BorrowHub SVNIT"
SMTP_TLS=True

# Brevo Transactional Email API
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="your-verified-sender@gmail.com"

# Public Application URL
PUBLIC_APP_URL="http://127.0.0.1:8000"